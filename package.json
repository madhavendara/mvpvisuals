{
  "name": "tent-showroom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run validate:assets && concurrently -k \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "PORT=3001 tsx watch server/index.ts",
    "build": "npm run validate:assets && tsc -b && tsc -p tsconfig.server.json && vite build",
    "validate:assets": "node scripts/validate-model-assets.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "tsx server/index.ts",
    "extract:uv": "node scripts/extract-uv-regions.mjs"
  },
  "dependencies": {
    "@fontsource/encode-sans-expanded": "^5.3.0",
    "@fontsource/overpass": "^5.3.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
